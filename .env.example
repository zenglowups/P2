PORT=8787
HOST=0.0.0.0
# Folosite la prima initializare a panoului owner sau dupa un reset complet de storage.
OWNER_USERNAME=afroditi
OWNER_PASSWORD=change-this-password
# Secret pentru cookie-ul de sesiune. Foloseste un sir lung si greu de ghicit.
OWNER_SESSION_SECRET=schimba-acest-secret-lung

# Server-side only: necesare pentru formularul public securizat.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-doar-pe-server
WHATSAPP_NUMBER=40742721408
SECURITY_EVENT_HASH_SECRET=schimba-acest-secret-lung-pentru-hashuri

# Optional: Cloudflare Turnstile. Secretul ramane doar server-side; site key este public prin /api/security-config.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# always | adaptive | off. Daca TURNSTILE_SECRET_KEY exista, default-ul din cod este always.
BOOKING_CAPTCHA_MODE=always

# Optional: domenii de email temporar sau abuzive, separate prin virgula.
BLOCKED_EMAIL_DOMAINS=
# Optional: origin-uri suplimentare permise pentru endpointul de formular.
BOOKING_ALLOWED_ORIGINS=
